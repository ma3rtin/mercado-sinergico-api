generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================
// VARIANTES Y PLANTILLAS
// ============================================

model Plantilla {
  id              Int              @id @default(autoincrement())
  nombre          String
  caracteristicas Caracteristica[]
  productos       Producto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Caracteristica {
  id          Int       @id @default(autoincrement())
  nombre      String
  plantillaId Int
  plantilla   Plantilla @relation(fields: [plantillaId], references: [id], onDelete: Cascade)

  opciones          Opcion[]
  variantesOpciones ProductoVarianteOpcion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opcion {
  id               Int            @id @default(autoincrement())
  nombre           String
  caracteristicaId Int
  caracteristica   Caracteristica @relation(fields: [caracteristicaId], references: [id], onDelete: Cascade)

  variantesOpciones ProductoVarianteOpcion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductoVariante {
  id         Int      @id @default(autoincrement())
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id_producto], onDelete: Cascade)
  sku        String?  @unique

  // Stock físico global (null = sinérgico sin control, número = energético con control)
  stockFisico Int?

  precioExtra Float?  @default(0)
  activo      Boolean @default(true)
  imagen_url  String?

  // Relaciones
  opciones                 ProductoVarianteOpcion[]
  pedidoDetalles           PedidoDetalle[]
  disponibilidadEnPaquetes DisponibilidadVariantePaquete[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productoId])
  @@index([activo])
}

model ProductoVarianteOpcion {
  id               Int              @id @default(autoincrement())
  varianteId       Int
  variante         ProductoVariante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  caracteristicaId Int
  caracteristica   Caracteristica   @relation(fields: [caracteristicaId], references: [id])
  opcionId         Int
  opcion           Opcion           @relation(fields: [opcionId], references: [id])

  @@unique([varianteId, caracteristicaId])
  @@index([varianteId])
}

model DisponibilidadVariantePaquete {
  id                 Int              @id @default(autoincrement())
  varianteId         Int
  variante           ProductoVariante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  paquetePublicadoId Int
  paquetePublicado   PaquetePublicado @relation(fields: [paquetePublicadoId], references: [id_paquete_publicado], onDelete: Cascade)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([varianteId, paquetePublicadoId])
  @@index([paquetePublicadoId])
  @@index([varianteId])
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

model Usuario {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  nombre      String
  contraseña String
  telefono    String
  fecha_nac   DateTime?
  imagen_url  String?
  direccion   Direccion?
  rolId       Int
  rol         Rol        @relation(fields: [rolId], references: [id])
  localidadId Int?
  localidad   Localidad? @relation(fields: [localidadId], references: [id_localidad])

  pedidos   Pedido[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
}

model Direccion {
  id            Int       @id @default(autoincrement())
  usuarioId     Int       @unique
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])
  localidadId   Int
  localidad     Localidad @relation(fields: [localidadId], references: [id_localidad])
  codigo_postal Int
  calle         String
  numero        Int
  piso          Int?
  departamento  String?
}

// ============================================
// GEOGRAFÍA
// ============================================

model Localidad {
  id_localidad  Int             @id @default(autoincrement())
  nombre        String
  codigo_postal Int
  direcciones   Direccion[]
  usuarios      Usuario[]
  zonas         LocalidadZona[]
}

model Zona {
  id_zona     Int                @id @default(autoincrement())
  nombre      String             @unique
  paquetes    PaquetePublicado[]
  localidades LocalidadZona[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocalidadZona {
  id          Int @id @default(autoincrement())
  localidadId Int
  zonaId      Int

  localidad Localidad @relation(fields: [localidadId], references: [id_localidad])
  zona      Zona      @relation(fields: [zonaId], references: [id_zona])

  @@unique([localidadId, zonaId])
}

// ============================================
// CATÁLOGO
// ============================================

model Categoria {
  id_categoria Int           @id @default(autoincrement())
  nombre       String        @unique
  productos    Producto[]
  paquetes     PaqueteBase[]
}

model Marca {
  id_marca  Int           @id @default(autoincrement())
  nombre    String        @unique
  productos Producto[]
  paquetes  PaqueteBase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Producto {
  id_producto Int     @id @default(autoincrement())
  nombre      String
  descripcion String
  precio      Float
  imagen_url  String?
  marca       Marca   @relation(fields: [marca_id], references: [id_marca])
  marca_id    Int
  altura      Float?
  ancho       Float?
  profundidad Float?
  peso        Float?

  // Stock solo para productos SIN variantes (plantillaId = null)
  stock Int?

  // Tipo de producto: ENERGICO (con stock) o SINERGICO (bajo pedido)
  tipo TipoPaquete? @default(POR_DEFINIR)

  plantillaId  Int?
  plantilla    Plantilla? @relation(fields: [plantillaId], references: [id])
  categoria_id Int
  categoria    Categoria  @relation(fields: [categoria_id], references: [id_categoria])

  // Relaciones
  paquetes       PaqueteBaseProducto[]
  imagenes       ProductoImagen[]
  pedidoDetalles PedidoDetalle[]
  variantes      ProductoVariante[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantillaId])
  @@index([categoria_id])
  @@index([marca_id])
  @@index([tipo])
}

model ProductoImagen {
  id         Int      @id @default(autoincrement())
  url        String
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id_producto], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ============================================
// PAQUETES
// ============================================

model PaqueteBase {
  id_paquete_base Int         @id @default(autoincrement())
  nombre          String
  descripcion     String
  imagen_url      String?
  categoria_id    Int
  categoria       Categoria   @relation(fields: [categoria_id], references: [id_categoria])
  marcaId         Int?
  marca           Marca?      @relation(fields: [marcaId], references: [id_marca])
  tipo            TipoPaquete @default(SINERGICO)

  productos  PaqueteBaseProducto[]
  publicados PaquetePublicado[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaqueteBaseProducto {
  id            Int         @id @default(autoincrement())
  productoId    Int
  paqueteBaseId Int
  producto      Producto    @relation(fields: [productoId], references: [id_producto], onDelete: Cascade)
  paqueteBase   PaqueteBase @relation(fields: [paqueteBaseId], references: [id_paquete_base], onDelete: Cascade)

  @@unique([productoId, paqueteBaseId])
}

enum TipoPaquete {
  SINERGICO
  ENERGICO
  POR_DEFINIR
}

model PaquetePublicado {
  id_paquete_publicado      Int                    @id @default(autoincrement())
  nombre                    String
  paqueteBaseId             Int
  paqueteBase               PaqueteBase            @relation(fields: [paqueteBaseId], references: [id_paquete_base])
  estadoId                  Int
  estado                    EstadoPaquetePublicado @relation(fields: [estadoId], references: [id_estado])
  zonaId                    Int
  zona                      Zona                   @relation(fields: [zonaId], references: [id_zona])
  fecha_inicio              DateTime
  fecha_fin                 DateTime
  cant_productos            Int?
  cant_productos_reservados Int                    @default(0)
  cant_usuarios_registrados Int                    @default(0)
  monto_total               Float?
  imagen_url                String?
  tipo                      TipoPaquete            @default(POR_DEFINIR)
  descuento                 Float?

  pedidos              Pedido[]
  variantesDisponibles DisponibilidadVariantePaquete[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estadoId])
  @@index([zonaId])
  @@index([tipo])
}

model EstadoPaquetePublicado {
  id_estado Int                @id @default(autoincrement())
  nombre    String             @unique
  paquetes  PaquetePublicado[]
}

// ============================================
// PEDIDOS
// ============================================

model Pedido {
  id_pedido          Int              @id @default(autoincrement())
  usuarioId          Int
  usuario            Usuario          @relation(fields: [usuarioId], references: [id])
  paquetePublicadoId Int
  paquetePublicado   PaquetePublicado @relation(fields: [paquetePublicadoId], references: [id_paquete_publicado])
  estadoId           Int
  estado             EstadoPedido     @relation(fields: [estadoId], references: [id_estado])
  monto_total        Float
  descuento_aplicado Float?
  paymentId          String?
  fecha              DateTime         @default(now())

  detalles  PedidoDetalle[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([usuarioId])
  @@index([paquetePublicadoId])
  @@index([estadoId])
}

model PedidoDetalle {
  id         Int      @id @default(autoincrement())
  pedidoId   Int
  pedido     Pedido   @relation(fields: [pedidoId], references: [id_pedido], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id_producto])

  // Nueva referencia a variante (null si el producto no tiene variantes)
  varianteId Int?
  variante   ProductoVariante? @relation(fields: [varianteId], references: [id])

  cantidad        Int
  precio_unitario Float
  subtotal        Float

  @@index([pedidoId])
  @@index([productoId])
  @@index([varianteId])
}

model EstadoPedido {
  id_estado Int      @id @default(autoincrement())
  nombre    String   @unique
  pedidos   Pedido[]
}
