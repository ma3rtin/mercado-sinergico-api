{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "test/services/test-email.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "prisma.config.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}